<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="7dp"
    android:background="@drawable/formula_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/chart_type_button" android:layout_width="0dp"
            android:layout_height="32dp" android:layout_weight="1" android:gravity="center_vertical"
            android:text="瓶喂奶量  ▾" android:textColor="@color/formula_widget_text"
            android:textSize="15sp" android:textStyle="bold" android:singleLine="true" />
        <TextView android:id="@+id/chart_range_button" android:layout_width="72dp"
            android:layout_height="32dp" android:gravity="center"
            android:text="7天  ▾" android:textColor="@color/formula_widget_muted"
            android:textSize="13sp" android:singleLine="true" />
    </LinearLayout>
    <ImageView android:id="@+id/chart_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:contentDescription="@string/formula_widget_description"
        android:scaleType="fitCenter" />
    <TextView android:id="@+id/chart_summary" android:layout_width="match_parent"
        android:layout_height="17dp" android:gravity="center_vertical"
        android:text="当前范围暂无记录" android:textColor="@color/formula_widget_muted"
        android:textSize="11sp" android:singleLine="true" />
</LinearLayout>
