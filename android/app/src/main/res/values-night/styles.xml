<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      系统深色模式下的原生默认主题：只在冷启动到 WebView 应用主题之前生效，
      App 内主题（含手动切换、跟随系统）由 SystemTheme 插件按实际主题精确校正。
    -->

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#7FA08D</item>
        <item name="colorPrimaryDark">#6D8E7B</item>
        <item name="colorAccent">#DDA072</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0D0C0B</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#0D0C0B</item>
    </style>
</resources>
