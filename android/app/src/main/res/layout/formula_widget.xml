<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/formula_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/formula_widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/chart_type_button" android:layout_width="0dp"
            android:layout_height="36dp" android:layout_weight="1" android:gravity="center_vertical"
            android:text="瓶喂奶量 · 近7天" android:textColor="@color/formula_widget_text"
            android:textSize="12sp" android:fontFamily="sans-serif-medium" android:singleLine="true" />
        <TextView android:id="@+id/chart_switch_button" android:layout_width="56dp"
            android:layout_height="36dp" android:gravity="center"
            android:text="切换" android:textColor="@color/formula_widget_muted"
            android:textSize="12sp" android:fontFamily="sans-serif-medium" android:singleLine="true"
            android:contentDescription="切换图表" />
    </LinearLayout>
    <ImageView android:id="@+id/chart_image" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:contentDescription="@string/formula_widget_chart_description"
        android:scaleType="fitCenter" />
    <TextView android:id="@+id/chart_summary" android:layout_width="match_parent"
        android:layout_height="16dp" android:gravity="center_vertical"
        android:text="当前范围暂无记录" android:textColor="@color/formula_widget_muted"
        android:textSize="11sp" android:singleLine="true" />
</LinearLayout>
