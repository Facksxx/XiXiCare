tabular-nums}.player-progress slider,.volume-row slider{margin:0}.player-controls{height:50px;display:flex;align-items:center;justify-content:center;gap:24px}.player-controls button{width:38px;height:38px;border:1px solid var(--line);border-radius:50%;color:var(--ink);font-size:16px}.player-controls .player-play{width:46px;height:46px;background:var(--sage);border-color:var(--sage);color:white;font-size:17px}.volume-row{height:34px;display:grid;grid-template-columns:30px 1fr 32px;align-items:center;gap:5px;font-size:10px;color:var(--muted)}.player-setting{padding-top:9px;margin-top:7px;border-top:1px solid var(--line)}.player-setting>text{display:block;font-size:11px;font-weight:700;margin-bottom:6px}.player-setting .segmented button{height:32px;font-size:10px}.timer-options{display:grid;grid-template-columns:repeat(4,1fr);gap:5px}.timer-options button{height:31px;border:1px solid var(--line);border-radius:9px;background:var(--control);font-size:10px;color:var(--muted)}.timer-options button.active{background:var(--sage);border-color:var(--sage);color:white}.dark-theme .sound-card-icon{background:var(--control)}
@media (min-width:700px){.record-card,.section,.guide-card,.chart-card,.range-card,.summary,.stage-picker{max-width:620px;margin-left:auto;margin-right:auto}.header{padding-left:max(22px,calc((100vw - 700px)/2));padding-right:max(22px,calc((100vw - 700px)/2))}.tabbar{padding-left:calc((100vw - 680px)/2);padding-right:calc((100vw - 680px)/2)}}

/* Mini-program alignment and page-specific refinements. */
.gear-icon{width:18px;height:18px;border:2px solid currentColor;border-radius:50%;position:relative;box-sizing:border-box}.gear-icon:before,.gear-icon:after{content:'';position:absolute;left:5px;top:-5px;width:4px;height:24px;border-top:3px solid currentColor;border-bottom:3px solid currentColor;box-sizing:border-box}.gear-icon:after{transform:rotate(90deg)}.gear-icon text{position:absolute;left:4px;top:4px;width:6px;height:6px;border:2px solid currentColor;border-radius:50%;box-sizing:border-box}
.content.settings-content{height:calc(100vh - var(--header-clear-height))}.page-title{position:sticky;top:0;z-index:12;height:54px;padding:0 14px;background:var(--panel);gap:10px}.page-title button{width:34px;height:34px;font-size:0}.back-chevron{width:9px;height:9px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg);margin-left:4px}.page-title text{font-size:20px}.settings-content .section{margin-top:10px;padding:12px}.settings-content .section-title{font-size:15px;margin-bottom:8px}.settings-content .small-action{height:30px;padding:0 10px;font-size:12px}.settings-content .baby-row,.settings-content .download-row{gap:9px;padding:9px 0}.settings-content .baby-row>.grow>text:first-child,.pack-title>text:first-child{font-size:13px;font-weight:700}.settings-content .download-row .small{font-size:10px;margin-top:3px}.settings-content .action-grid{gap:7px}.settings-content .action-grid button{height:44px;font-size:13px}.settings-content .contact{font-size:12px}.pack-title{display:flex;align-items:center;gap:6px}.pack-title>text:last-child{font-size:9px;color:var(--sage);font-weight:650}.pack-symbol{font-size:11px;font-weight:800}.download-icon>view{width:12px;height:12px;border-bottom:2px solid currentColor;position:relative}.download-icon>view:before{content:'';position:absolute;left:5px;top:-5px;height:10px;border-left:2px solid currentColor}.download-icon>view:after{content:'';position:absolute;left:2px;top:1px;width:6px;height:6px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(-45deg)}
.round-action-icon{width:19px;height:19px;display:block}
.record-tabs button{gap:0}.date-row.with-now{grid-template-columns:minmax(0,1.55fr) minmax(76px,.8fr) 74px}.date-row>button{font-size:11px;white-space:nowrap;padding:0 5px}
.page-heading{font-size:23px;padding:18px 16px 3px}.filter-scroll{padding:10px 0 12px}.filters{gap:7px}.filters button{height:32px;padding:0 16px;font-size:12px;background:var(--panel);color:var(--ink)}.timeline-group{margin:0 14px 14px}.timeline-date{display:block;font-size:14px;font-weight:750;color:var(--ink);margin:0 2px 8px}.timeline-list{border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden}.timeline-group .timeline-row{min-height:66px;margin:0;padding:10px 11px;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;box-sizing:border-box}.timeline-group .timeline-row:last-child{border-bottom:0}.timeline-icon{flex:none}.timeline-icon.feeding{background:var(--peach-soft);color:var(--peach)}.timeline-icon.sleep{background:#f0edf8;color:#8e83aa}.timeline-icon.growth{background:#fbecee;color:#cf7f86}.timeline-copy .strong{display:block;font-size:14px;color:var(--ink)}.timeline-time{display:flex;align-items:center;gap:7px;margin-top:4px}.timeline-time text{font-size:10px;color:var(--muted);margin:0}.timeline-group .timeline-row .small{font-size:10px;margin-top:3px}.row-actions button{font-size:0}.edit-icon{width:12px;height:4px;border:2px solid currentColor;border-radius:2px;transform:rotate(-45deg)}.row-actions .trash-icon,.round-action .trash-icon{width:11px;height:13px;border:2px solid currentColor;border-top:0;border-radius:0 0 2px 2px;position:relative}.trash-icon:before{content:'';position:absolute;left:-3px;top:-4px;width:13px;border-top:2px solid currentColor}.trash-icon:after{content:'';position:absolute;left:2px;top:-7px;width:4px;border-top:2px solid currentColor}
.sound-pack-empty{height:145px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);font-size:11px;padding:0 28px;box-sizing:border-box}

/* Shared icon language: local Lucide assets mirror the original application. */
.inline-icon{width:15px;height:15px;margin-left:3px}.icon-button image{width:20px;height:20px}.page-title button image{width:20px;height:20px}.settings-symbol image,.sound-symbol image{width:19px;height:19px}.action-grid image{width:17px;height:17px}.timeline-icon image{width:19px;height:19px}.row-actions image{width:15px;height:15px}.tabbar .nav-icon{width:23px;height:23px;display:block}.tabbar button.active .nav-icon{transform:scale(1.06)}
.small-action{gap:4px}.small-action image{width:14px;height:14px}.timer-actions button image{width:19px;height:19px}.player-header button image{width:18px;height:18px}.player-controls button image{width:19px;height:19px}.player-controls .player-play image{width:22px;height:22px}.avatar-editor{display:flex;align-items:center;gap:13px;margin:2px 0 12px}.avatar-preview{width:62px;height:62px;flex:none;padding:0;border-radius:50%;overflow:hidden;background:linear-gradient(145deg,#efc09e,#86aa94);color:white;font-size:22px;font-weight:750}.avatar-preview image{width:100%;height:100%;display:block}.avatar-editor>view{display:flex;gap:7px}.avatar-action{height:32px;padding:0 10px;border:1px solid var(--sage);border-radius:9px;color:var(--sage);font-size:11px}.avatar-action.danger{border-color:#d88;color:#c66}

/* Settings page follows the original section-heading structure. */
.settings-section-heading{min-height:42px;display:flex;align-items:center;gap:10px;margin-bottom:8px}.settings-symbol{width:36px;height:36px;flex:none;border-radius:10px;background:var(--sage-soft);display:flex;align-items:center;justify-content:center}.settings-section-heading>.grow>text{display:block}.settings-section-heading>.grow>text:first-child{font-size:14px;font-weight:750;color:var(--ink)}.settings-section-heading>.grow>text:last-child{margin-top:3px;font-size:10px;color:var(--muted)}.settings-content .section{padding-top:10px;padding-bottom:10px}.settings-content .action-grid button{gap:6px}.settings-content .contact{min-height:42px;display:grid;grid-template-columns:36px 1fr auto;align-items:center;gap:10px}.settings-content .contact>text:nth-child(2){font-size:13px;font-weight:700}.settings-content .contact>text:last-child{font-size:11px;color:var(--muted)}

/* Original timeline query panel and record list. */
.page-heading{padding-top:12px}.records-tools-card{margin:9px 14px 12px;padding:12px;background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 8px 24px rgba(82,67,53,.04)}.records-date-range{height:36px;display:grid;grid-template-columns:16px minmax(0,1fr) 10px minmax(0,1fr) auto;align-items:center;gap:5px}.records-date-range>image{width:15px;height:15px}.records-date-range picker{min-width:0}.date-filter{height:34px;padding:0 7px;border:1px solid var(--line);border-radius:8px;background:var(--control);display:flex;align-items:center;color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden}.date-filter.filled{color:var(--ink);font-weight:600}.records-date-range>text{color:var(--muted);font-size:11px}.records-date-range>button{height:30px;padding:0 7px;border:1px solid var(--line);border-radius:7px;color:var(--muted);font-size:10px;white-space:nowrap}.records-type-filter{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px;margin-top:9px;padding:3px;border:1px solid var(--line);border-radius:9px;background:var(--control)}.records-type-filter button{height:31px;min-width:0;border-radius:7px;color:var(--muted);font-size:11px}.records-type-filter button.on{background:var(--panel);color:var(--sage);font-weight:700;box-shadow:0 2px 7px rgba(72,61,50,.08)}.records-feeding-filter{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;margin-top:6px}.records-feeding-filter button{height:29px;min-width:0;padding:0 3px;border:1px solid var(--line);border-radius:7px;color:var(--muted);font-size:10px;white-space:nowrap}.records-feeding-filter button.on{border-color:var(--sage);background:var(--sage-soft);color:var(--sage);font-weight:700}.records-count{margin-top:9px;padding-top:8px;border-top:1px solid var(--line);display:flex;align-items:center;gap:5px;color:var(--muted);font-size:10px}.records-count image{width:13px;height:13px}.records-count text text{color:var(--sage);font-weight:750}.timeline-group{margin-bottom:12px}.timeline-list{overflow:hidden}.timeline-feeding-meta{display:block;margin-top:3px!important;color:var(--sage)!important;font-size:10px!important}.timeline-time{margin-top:3px}

/* ECharts must never paint outside its own card. */
.chart-card{overflow:hidden;contain:layout paint}.chart-stage{height:245px;overflow:hidden;position:relative;z-index:0;isolation:isolate}.chart-canvas{width:100%;height:245px;display:block;overflow:hidden;position:relative;z-index:0}
