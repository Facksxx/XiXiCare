<view class="app {{dark?'dark-theme':''}}" style="--status-height:{{statusBarHeight}}px;--header-clear-height:{{headerClearHeight}}px;">
  <view class="top-safe"></view>
  <view class="header" wx:if="{{!showSettings}}">
    <view class="baby-head" bindtap="editBaby">
      <view class="avatar"><image wx:if="{{baby.avatar}}" src="{{baby.avatar}}" mode="aspectFill"/><text wx:else>{{baby.initial || '宝'}}</text></view>
      <view class="baby-copy"><view class="baby-name"><text>{{baby.name || '未设置'}}</text><image class="inline-icon" src="/assets/icons/chevronDown.svg" mode="aspectFit"/></view><text>{{baby.birthday || '--'}}{{baby.birthday ? ' · '+ageDays+'天' : ''}}</text></view>
    </view>
    <view class="header-actions">
      <button class="icon-button" bindtap="openSettings" aria-label="设置"><image src="/assets/icons/settings.svg" mode="aspectFit"/></button>
      <button class="icon-button {{isPlaying?'active':''}}" bindtap="openPlayer" aria-label="睡眠声音"><image src="/assets/icons/music{{isPlaying?'-active':''}}.svg" mode="aspectFit"/></button>
      <button class="icon-button" bindtap="toggleTheme" aria-label="切换主题"><image src="/assets/icons/{{dark?'sun':'moon'}}.svg" mode="aspectFit"/></button>
    </view>
  </view>

  <scroll-view class="content {{showSettings?'settings-content':''}}" scroll-y="true" enhanced="true" show-scrollbar="false">
    <block wx:if="{{showSettings}}">
      <view class="page-title"><button bindtap="closeSettings" aria-label="返回"><image src="/assets/icons/chevronLeft.svg" mode="aspectFit"/></button><text>设置</text></view>
      <view class="section">
        <view class="settings-section-heading"><view class="settings-symbol"><image src="/assets/icons/users-active.svg" mode="aspectFit"/></view><view class="grow"><text>宝宝管理</text><text>当前共 {{babies.length}} 位宝宝</text></view><button class="small-action" bindtap="openBaby"><image src="/assets/icons/plus.svg" mode="aspectFit"/>添加</button></view>
        <view wx:for="{{babies}}" wx:key="id" class="baby-row {{item.id===baby.id?'selected':''}}" data-id="{{item.id}}" bindtap="switchBaby">
          <view class="mini-avatar"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"/><text wx:else>{{item.initial}}</text></view><view class="grow"><text>{{item.name}}</text><text class="small">{{item.birthday}}{{item.id===baby.id?' · 当前宝宝':''}}</text></view><image class="row-chevron" src="/assets/icons/chevronDown.svg" mode="aspectFit"/>
        </view>
      </view>
      <view class="section">
        <view class="settings-section-heading"><view class="settings-symbol"><image src="/assets/icons/database-active.svg" mode="aspectFit"/></view><view class="grow"><text>数据管理</text><text>完整备份与恢复宝宝记录</text></view></view>
        <view class="action-grid"><button bindtap="exportData"><image src="/assets/icons/download-active.svg" mode="aspectFit"/>导出全部数据</button><button bindtap="importData"><image src="/assets/icons/upload-active.svg" mode="aspectFit"/>导入全部数据</button></view>
      </view>
      <view class="section">
        <view class="settings-section-heading"><view class="settings-symbol"><image src="/assets/icons/music-active.svg" mode="aspectFit"/></view><view class="grow"><text>睡眠声音包</text><text>下载和管理本地声音资源</text></view></view>
        <view wx:for="{{soundPackRows}}" wx:key="id" class="download-row pack-row">
          <view class="sound-symbol pack-symbol"><image src="/assets/icons/music-active.svg" mode="aspectFit"/></view><view class="grow"><view class="pack-title"><text>{{item.name}}</text><text wx:if="{{item.installed}}">✓ 已下载</text></view><text class="small">{{item.downloading?'正在下载 '+item.progress+'%':item.description+' · '+item.size}}</text><view wx:if="{{item.downloading}}" class="progress"><view style="width:{{item.progress}}%"></view></view></view>
          <button wx:if="{{item.downloading}}" class="round-action danger" data-id="{{item.id}}" bindtap="cancelSoundPack" aria-label="取消下载"><image class="round-action-icon" src="/assets/icons/close-danger.svg" mode="aspectFit"/></button>
          <button wx:elif="{{!item.installed}}" class="round-action" data-id="{{item.id}}" bindtap="downloadSoundPack" aria-label="下载"><image class="round-action-icon" src="/assets/icons/download-active.svg" mode="aspectFit"/></button>
          <button wx:else class="round-action danger" data-id="{{item.id}}" bindtap="removeSoundPack" aria-label="删除"><image class="round-action-icon" src="/assets/icons/trash-active.svg" mode="aspectFit"/></button>
        </view>
      </view>
      <view class="section contact"><view class="settings-symbol"><image src="/assets/icons/message-active.svg" mode="aspectFit"/></view><text>联系作者</text><text>微信 Facksxx</text></view>
    </block>

    <block wx:elif="{{activeTab==='dashboard'}}">
      <view class="record-card">
        <view wx:if="{{editingLogId}}" class="editing-banner"><view><text>编辑模式</text><text>正在修改当前记录</text></view><button bindtap="cancelEdit">取消</button></view>
        <view class="segmented record-tabs">
          <button class="{{recordType==='feeding'?'selected peach':''}}" data-id="feeding" bindtap="setRecordType">喂养</button>
          <button class="{{recordType==='sleep'?'selected':''}}" data-id="sleep" bindtap="setRecordType">睡眠</button>
          <button class="{{recordType==='diaper'?'selected':''}}" data-id="diaper" bindtap="setRecordType">尿布</button>
          <button class="{{recordType==='growth'?'selected':''}}" data-id="growth" bindtap="setRecordType">体征</button>
        </view>
        <view class="divider"></view>
        <view class="time-section">
          <text class="field-caption">{{recordType==='feeding'||recordType==='sleep'?'开始时间':'记录时间'}}</text>
          <view class="date-row {{recordType==='diaper'||recordType==='growth'?'with-now':''}}"><picker mode="date" value="{{date}}" bindchange="onDate"><view>{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="onTime"><view>{{time}}</view></picker><button wx:if="{{recordType==='diaper'||recordType==='growth'}}" bindtap="setNow">设为当前</button></view>
        </view>

        <block wx:if="{{recordType==='feeding'}}">
          <view class="segmented mode-tabs"><button class="{{feedingType==='breast'?'selected peach':''}}" data-id="breast" bindtap="setFeedingType">母乳亲喂</button><button class="{{feedingType==='bottle'?'selected peach':''}}" data-id="bottle" bindtap="setFeedingType">奶瓶喂养</button><button class="{{feedingType==='solids'?'selected peach':''}}" data-id="solids" bindtap="setFeedingType">添加辅食</button></view>
          <view wx:if="{{feedingType==='breast'}}" class="dual-controls">
            <view class="metric"><text>左侧（分钟）</text><view class="stepper"><button data-key="left" data-delta="-1" bindtap="step"><image src="/assets/icons/minus.svg" mode="aspectFit"/></button><text class="strong">{{left}}</text><button data-key="left" data-delta="1" bindtap="step"><image src="/assets/icons/plus.svg" mode="aspectFit"/></button></view><view class="presets"><button wx:for="{{minutePresets}}" wx:key="*this" data-key="left" data-value="{{item}}" bindtap="preset" class="{{left===item?'on':''}}">{{item}}</button></view></view>
            <view class="metric"><text>右侧（分钟）</text><view class="stepper"><button data-key="right" data-delta="-1" bindtap="step"><image src="/assets/icons/minus.svg" mode="aspectFit"/></button><text class="strong">{{right}}</text><button data-key="right" data-delta="1" bindtap="step"><image src="/assets/icons/plus.svg" mode="aspectFit"/></button></view><view class="presets"><button wx:for="{{minutePresets}}" wx:key="*this" data-key="right" data-value="{{item}}" bindtap="preset" class="{{right===item?'on':''}}">{{item}}</button></view></view>
          </view>
          <view wx:elif="{{feedingType==='bottle'}}">
            <view class="segmented compact"><button class="{{bottleType==='formula'?'selected':''}}" data-id="formula" bindtap="setBottleType">配方奶</button><button class="{{bottleType==='breastmilk'?'selected':''}}" data-id="breastmilk" bindtap="setBottleType">母乳</button></view>
            <view class="metric"><text>喂奶量（ml）</text><view class="stepper"><button data-key="volume" data-delta="-10" bindtap="step"><image src="/assets/icons/minus.svg" mode="aspectFit"/></button><text class="strong">{{volume}}<text class="small">ml</text></text><button data-key="volume" data-delta="10" bindtap="step"><image src="/assets/icons/plus.svg" mode="aspectFit"/></button></view><view class="presets"><button wx:for="{{volumePresets}}" wx:key="*this" data-key="volume" data-value="{{item}}" bindtap="preset" class="{{volume===item?'on':''}}">{{item}}</button></view></view>
          </view>
          <view wx:else class="form-stack"><label>食物名称<input placeholder="如：胡萝卜泥" data-key="foodName" value="{{foodName}}" bindinput="input"/></label><label>摄入量<input placeholder="如：50g" data-key="foodAmount" value="{{foodAmount}}" bindinput="input"/></label><picker range="{{reactions}}" value="{{reactionIndex}}" bindchange="onReaction"><view class="input-like">过敏反应：{{reactions[reactionIndex]}}</view></picker></view>
        </block>

        <block wx:elif="{{recordType==='sleep'}}"><view class="sleep-timer-panel {{sleepTimerActive?'active':''}}"><text>睡眠计时</text><text class="timer-clock">{{sleepTimerClock}}</text><view class="timer-actions"><button bindtap="toggleSleepTimer"><image src="/assets/icons/{{sleepTimerActive&&sleepTimerRunning?'pause':'play'}}.svg" mode="aspectFit"/></button><button wx:if="{{sleepTimerActive}}" bindtap="cancelSleepTimer"><image src="/assets/icons/close-danger.svg" mode="aspectFit"/></button></view></view><block wx:if="{{!sleepTimerActive}}"><view class="timer-divider"><text></text><text>或手动填写时长</text><text></text></view><view class="metric centered"><text>睡眠时长</text><view class="stepper"><button data-key="sleepMinutes" data-delta="-5" bindtap="step"><image src="/assets/icons/minus.svg" mode="aspectFit"/></button><text class="strong">{{sleepMinutes}}<text class="small">分钟</text></text><button data-key="sleepMinutes" data-delta="5" bindtap="step"><image src="/assets/icons/plus.svg" mode="aspectFit"/></button></view><view class="presets"><button wx:for="{{sleepPresets}}" wx:key="*this" data-key="sleepMinutes" data-value="{{item}}" bindtap="preset" class="{{sleepMinutes===item?'on':''}}">{{item}}分钟</button></view></view></block></block>
        <block wx:elif="{{recordType==='diaper'}}"><view class="choice-row"><button class="{{pee?'choice-on':''}}" data-key="pee" bindtap="toggle">嘘嘘</button><button class="{{poop?'choice-on peach':''}}" data-key="poop" bindtap="toggle">便便</button></view><view wx:if="{{poop}}" class="diaper-details"><text>便便颜色</text><view class="segmented"><button data-key="poopColor" data-value="yellow" bindtap="setOption" class="{{poopColor==='yellow'?'selected':''}}">黄色</button><button data-key="poopColor" data-value="green" bindtap="setOption" class="{{poopColor==='green'?'selected':''}}">绿色</button><button data-key="poopColor" data-value="brown" bindtap="setOption" class="{{poopColor==='brown'?'selected':''}}">棕色</button><button data-key="poopColor" data-value="other" bindtap="setOption" class="{{poopColor==='other'?'selected':''}}">其他</button></view><text>便便性状</text><view class="segmented"><button data-key="poopConsistency" data-value="watery" bindtap="setOption" class="{{poopConsistency==='watery'?'selected':''}}">稀水</button><button data-key="poopConsistency" data-value="normal" bindtap="setOption" class="{{poopConsistency==='normal'?'selected':''}}">正常</button><button data-key="poopConsistency" data-value="hard" bindtap="setOption" class="{{poopConsistency==='hard'?'selected':''}}">偏硬</button></view></view></block>
        <block wx:else><view class="segmented mode-tabs"><button wx:for="{{growthOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="setGrowthKind" class="{{growthKind===item.id?'selected':''}}">{{item.name}}</button></view><view class="form-stack"><label>{{growthKind==='weight'?'体重（kg）':growthKind==='height'?'身高（cm）':'体温（℃）'}}<input type="digit" data-key="growthValue" value="{{growthValue}}" bindinput="input"/></label></view></block>
        <button class="save" bindtap="saveRecord"><image src="/assets/icons/check-light.svg" mode="aspectFit"/>{{editingLogId?'更新记录':'保存记录'}}</button>
      </view>
    </block>

    <block wx:elif="{{activeTab==='timeline'}}">
      <view class="page-heading">时间轴</view>
      <view class="records-tools-card">
        <view class="records-date-range"><image src="/assets/icons/calendar.svg" mode="aspectFit"/><picker mode="date" value="{{timelineStartDate}}" data-key="timelineStartDate" bindchange="setTimelineDate"><view class="date-filter {{timelineStartDate?'filled':''}}">{{timelineStartDate||'开始日期'}}</view></picker><text>~</text><picker mode="date" value="{{timelineEndDate}}" data-key="timelineEndDate" bindchange="setTimelineDate"><view class="date-filter {{timelineEndDate?'filled':''}}">{{timelineEndDate||'结束日期'}}</view></picker><button wx:if="{{timelineStartDate||timelineEndDate||timelineType!=='all'||timelineFeedingType!=='all'||timelineBottleType!=='all'}}" bindtap="clearTimelineFilters">清除</button></view>
        <view class="records-type-filter"><button wx:for="{{timelineOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="setTimelineType" class="{{timelineType===item.id?'on':''}}">{{item.n}}</button></view>
        <view wx:if="{{timelineType==='feeding'}}" class="records-feeding-filter"><button wx:for="{{timelineFeedingOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="setTimelineFeedingType" class="{{timelineFeedingType===item.id?'on':''}}">{{item.n}}</button></view>
        <view wx:if="{{timelineType==='feeding'&&timelineFeedingType==='bottle'}}" class="records-feeding-filter"><button wx:for="{{timelineBottleOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="setTimelineBottleType" class="{{timelineBottleType===item.id?'on':''}}">{{item.n}}</button></view>
        <view class="records-count"><image src="/assets/icons/calendar-active.svg" mode="aspectFit"/><text>共 <text>{{filteredLogs.length}}</text> 条记录{{timelineStartDate||timelineEndDate||timelineType!=='all'||timelineFeedingType!=='all'||timelineBottleType!=='all'?'（已筛选）':''}}</text></view>
      </view>
      <view wx:if="{{!filteredLogs.length}}" class="empty">当前没有记录</view>
      <view wx:for="{{timelineGroups}}" wx:key="dateKey" class="timeline-group" wx:for-item="group"><text class="timeline-date">{{group.title}}</text><view class="timeline-list"><view wx:for="{{group.logs}}" wx:key="id" class="timeline-row"><view class="timeline-icon {{item.logType}}"><image src="/assets/icons/{{item.iconName}}.svg" mode="aspectFit"/></view><view class="grow timeline-copy"><text class="strong">{{item.title}}</text><text class="timeline-feeding-meta" wx:if="{{item.logType==='feeding'}}">{{item.metadata.feedingType==='bottle'?'奶瓶':item.metadata.feedingType==='solids'?'辅食':'母乳'}}{{item.interval?' · '+item.interval:''}}</text><view class="timeline-time"><text>{{item.dateKey}}</text><text>{{item.displayTime}}</text></view></view><view class="row-actions"><button data-id="{{item.id}}" bindtap="editLog" aria-label="编辑"><image src="/assets/icons/edit-active.svg" mode="aspectFit"/></button><button data-id="{{item.id}}" bindtap="deleteLog" aria-label="删除"><image src="/assets/icons/trash.svg" mode="aspectFit"/></button></view></view></view></view>
    </block>

    <block wx:elif="{{activeTab==='guide'}}">
      <scroll-view scroll-x="true" class="guide-scroller" show-scrollbar="false"><view class="guide-pills"><button wx:for="{{guides}}" wx:key="id" data-index="{{index}}" bindtap="selectGuideTab" class="{{guideIndex===index?'active':''}}">{{item.age}}</button></view></scroll-view>

      <view class="guide-card">
        <view class="guide-title"><text class="guide-title-icon amber">餐</text><text>喂养建议（乳类）</text></view>
        <view class="guide-milk-grid"><view><text>推荐奶量</text><text>{{guide.amount}}</text></view><view><text>喂养频次</text><text>{{guide.frequency}}</text></view></view>
        <view class="guide-note"><text>喂养指南要点</text><text>{{guide.milkTip}}</text></view>
      </view>

      <view class="guide-card" wx:if="{{guide.solids}}">
        <view class="guide-title"><text class="guide-title-icon">勺</text><text>辅食引入计划</text></view>
        <text class="solids-title">{{guide.solids.title}}</text><text class="solids-text">【推荐性状】{{guide.solids.texture}}</text>
        <view class="allergen-panel"><text class="panel-title">过敏原排查清单（点击切换状态）</text><view wx:for="{{guide.solids.allergens}}" wx:key="*this" class="allergen-row" data-name="{{item}}" bindtap="cycleAllergen"><text>{{item}}</text><text class="status {{allergens[item]||'untested'}}">{{allergens[item]==='safe'?'✓ 安全':allergens[item]==='allergic'?'! 过敏':'? 未排查'}}</text></view><text class="panel-footnote">建议中午尝试新食物，连续观察3天，确认无异常后标记为安全。</text></view>
        <view class="guide-tip"><text>添加小贴士</text><text>{{guide.solids.tip}}</text></view>
      </view>

      <view class="guide-card">
        <view class="guide-title"><text class="guide-title-icon rose">针</text><text>疫苗接种</text></view>
        <button wx:for="{{guide.vaccines}}" wx:key="name" class="vaccine-row {{vaccines[guide.id+':'+item.name]?'completed':''}}" data-name="{{item.name}}" bindtap="toggleVaccine"><text class="vaccine-check">{{vaccines[guide.id+':'+item.name]?'✓':'✦'}}</text><view class="vaccine-copy"><view><text>{{item.name}}</text><text>{{item.age}}</text></view><text wx:if="{{item.note}}">{{item.note}}</text></view><text class="vaccine-state">{{vaccines[guide.id+':'+item.name]?'已接种':'未接种'}}</text></button>
        <text class="guide-footnote">以上接种时间仅供参考，具体请遵循当地疾控中心或儿科医生建议。</text>
      </view>

      <view class="guide-card milestone-card">
        <view class="guide-title"><text class="guide-title-icon lavender">星</text><text>发育里程碑</text></view>
        <view class="milestone-group"><text>大动作发育</text><text wx:for="{{guide.milestones.gross}}" wx:key="*this">• {{item}}</text></view>
        <view class="milestone-group"><text>精细动作发育</text><text wx:for="{{guide.milestones.fine}}" wx:key="*this">• {{item}}</text></view>
        <view class="milestone-group"><text>语言与社交</text><text wx:for="{{guide.milestones.social}}" wx:key="*this">• {{item}}</text></view>
      </view>
    </block>

    <block wx:else>
      <view class="summary stats-summary"><view><text class="small">今日瓶喂</text><text class="strong">{{todaySummary.milk}}<text>ml</text></text></view><view><text class="small">今日睡眠</text><text class="strong">{{todaySummary.sleep}}<text>小时</text></text></view><view><text class="small">今日嘘嘘</text><text class="strong">{{todaySummary.pee}}<text>次</text></text></view><view><text class="small">今日便便</text><text class="strong">{{todaySummary.poop}}<text>次</text></text></view></view>
      <view class="range-card"><text>图表范围</text><view class="segmented"><button wx:for="{{ranges}}" wx:key="*this" data-value="{{item}}" bindtap="setRange" class="{{range===item?'selected':''}}">{{item===365?'1年':item+'天'}}</button></view><text class="range-hint">根据所选范围自动汇总并调整横轴密度</text></view>
      <view class="chart-card"><view class="chart-heading"><text class="chart-badge milk">瓶</text><view><text class="strong">瓶喂奶量</text><text class="small">{{range===7?'每日':'按范围日均'}}，单位 ml/天</text></view></view><view class="chart-stage"><ec-canvas class="chart-canvas" id="chart-milk" canvas-id="chart-milk-canvas" ec="{{chartEc}}"></ec-canvas></view></view>
      <view class="chart-card"><view class="chart-heading"><text class="chart-badge sleep">眠</text><view><text class="strong">睡眠时长</text><text class="small">{{range===7?'每日':'按范围日均'}}，单位 小时/天</text></view></view><view class="chart-stage"><ec-canvas class="chart-canvas" id="chart-sleep" canvas-id="chart-sleep-canvas" ec="{{chartEc}}"></ec-canvas></view></view>
      <view class="chart-card"><view class="chart-heading"><text class="chart-badge interval">时</text><view><text class="strong">喂养间隔</text><text class="small">有效喂养记录均值，单位 小时</text></view></view><view class="chart-stage"><ec-canvas class="chart-canvas" id="chart-interval" canvas-id="chart-interval-canvas" ec="{{chartEc}}"></ec-canvas></view></view>
      <view class="chart-card"><view class="chart-heading"><text class="chart-badge diaper">滴</text><view><text class="strong">排泄统计</text><text class="small">{{range===7?'每日':'按范围日均'}}，单位 次/天</text></view></view><view class="chart-stage"><ec-canvas class="chart-canvas" id="chart-diaper" canvas-id="chart-diaper-canvas" ec="{{chartEc}}"></ec-canvas></view><view class="chart-legend"><text><text class="sage-dot"></text>嘘嘘</text><text><text class="peach-dot"></text>便便</text></view></view>
      <view class="chart-card"><view class="chart-heading"><text class="chart-badge weight">秤</text><view><text class="strong">体重增长</text><text class="small">仅显示实际体重记录，单位 kg</text></view></view><view class="chart-stage"><ec-canvas class="chart-canvas" id="chart-weight" canvas-id="chart-weight-canvas" ec="{{chartEc}}"></ec-canvas></view></view>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>

  <view class="tabbar" wx:if="{{!showSettings}}"><button wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bindtap="switchTab" class="{{activeTab===item.id?'active':''}}"><image class="nav-icon" src="/assets/icons/{{item.id==='dashboard'?'calendar':item.id==='timeline'?'sparkles':item.id==='guide'?'book':'stats'}}{{activeTab===item.id?'-active':''}}.svg" mode="aspectFit"/><text class="small">{{item.name}}</text></button></view>

  <view class="overlay" wx:if="{{showBabyModal}}" catchtouchmove="noop"><view class="modal"><view class="modal-title">{{editBabyId?'编辑宝宝信息':'添加宝宝信息'}}</view><view class="avatar-editor"><button class="avatar-preview" bindtap="chooseBabyAvatar"><image wx:if="{{babyAvatar}}" src="{{babyAvatar}}" mode="aspectFill"/><text wx:else>{{babyName ? babyName[0] : '宝'}}</text></button><view><button class="avatar-action" bindtap="chooseBabyAvatar">选择照片</button><button wx:if="{{babyAvatar}}" class="avatar-action danger" bindtap="removeBabyAvatar">移除头像</button></view></view><label>宝宝名字<input data-key="babyName" value="{{babyName}}" placeholder="请输入宝宝名字" bindinput="input"/></label><label>出生日期<picker mode="date" value="{{babyBirthday}}" bindchange="input" data-key="babyBirthday"><view class="input-like">{{babyBirthday||'选择出生日期'}}</view></picker></label><button class="save" bindtap="saveBaby"><image src="/assets/icons/check-light.svg" mode="aspectFit"/>{{editBabyId?'保存':'开始使用'}}</button><button wx:if="{{babies.length}}" class="cancel" bindtap="closeBaby">取消</button></view></view>

  <view class="overlay dark player-overlay" wx:if="{{showPlayer}}" catchtouchmove="noop" bindtap="closePlayer">
    <view class="player" catchtap="noop">
      <view class="player-header"><text>睡眠声音</text><button bindtap="closePlayer" aria-label="关闭"><image src="/assets/icons/close.svg" mode="aspectFit"/></button></view>
      <view class="segmented player-categories"><button data-id="ambient" bindtap="setSoundCategory" class="{{soundCategory==='ambient'?'selected':''}}">环境声音</button><button data-id="music" bindtap="setSoundCategory" class="{{soundCategory==='music'?'selected':''}}">纯音乐</button></view>
      <scroll-view scroll-y="true" class="sound-library" show-scrollbar="false"><view wx:if="{{!visibleSounds.length}}" class="sound-pack-empty">请先前往设置下载{{soundCategory==='ambient'?'环境声音包':'纯音乐包'}}</view><view class="sound-grid"><button wx:for="{{visibleSounds}}" wx:key="id" class="sound-card {{playingId===item.id?'active':''}}" data-id="{{item.id}}" bindtap="playSound"><text class="sound-card-icon icon-{{item.id}}">{{item.icon}}</text><text>{{item.name}}</text></button></view></scroll-view>

      <view class="now-playing">
        <view class="disc {{isPlaying?'playing':''}}">{{playingIcon}}</view>
        <view class="now-copy"><text class="small">正在播放</text><text class="strong">{{playingName}}</text></view>
        <view class="loop-status">{{loopMode==='track'?'单曲循环':loopMode==='list'?'列表循环':'播放一次'}}</view>
      </view>
      <view class="player-progress"><text>{{playerTime}}</text><slider min="0" max="100" value="{{playerProgress}}" block-size="12" activeColor="#82a894" backgroundColor="#ebe6df" bindchange="seekPlayer"/><text>{{playerDurationText}}</text></view>
      <view class="player-controls"><button bindtap="prevSound" aria-label="上一首"><image src="/assets/icons/skip-back.svg" mode="aspectFit"/></button><button class="player-play" bindtap="togglePlayerPlayback" aria-label="播放或暂停"><image src="/assets/icons/{{isPlaying?'pause':'play'}}.svg" mode="aspectFit"/></button><button bindtap="nextSound" aria-label="下一首"><image src="/assets/icons/skip-forward.svg" mode="aspectFit"/></button></view>
      <view class="volume-row"><text>音量</text><slider min="0" max="100" value="{{playerVolume}}" block-size="12" activeColor="#82a894" backgroundColor="#ebe6df" bindchanging="setPlayerVolume" bindchange="setPlayerVolume"/><text>{{playerVolume}}%</text></view>
      <view class="player-setting"><text>循环模式</text><view class="segmented"><button wx:for="{{loopModes}}" wx:key="id" data-id="{{item.id}}" bindtap="setLoopMode" class="{{loopMode===item.id?'selected':''}}">{{item.name}}</button></view></view>
      <view class="player-setting timer-setting"><text>{{playerTimerText}}</text><view class="timer-options"><button wx:for="{{playerTimerOptions}}" wx:key="*this" data-value="{{item}}" bindtap="setPlayerTimer" class="{{playerTimerMinutes===item?'active':''}}">{{item===0?'关闭':item+' 分'}}</button></view></view>
    </view>
  </view>

  <view class="overlay" wx:if="{{showImportMode}}"><view class="modal"><view class="modal-title">选择导入方式</view><button class="mode-action" data-mode="merge" bindtap="applyImport"><text class="strong">合并</text><text>保留已有数据并导入备份</text></button><button class="mode-action" data-mode="cover" bindtap="applyImport"><text class="strong">覆盖</text><text>清空当前数据后恢复备份</text></button><button class="cancel" bindtap="closeImport">取消</button></view></view>
</view>
