page { background: #fbfaf8; color: #292622; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { padding: 0; margin: 0; line-height: 1; background: transparent; border-radius: 0; }
button::after { border: 0; }
view, text, button, input, picker, scroll-view, canvas { box-sizing: border-box; }
