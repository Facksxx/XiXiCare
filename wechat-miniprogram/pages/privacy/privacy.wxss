.policy-head { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; }
.policy-head .settings-copy { flex: 1; min-width: 0; }
.policy-head .muted { margin-top: 8rpx; }
.policy-summary { white-space: nowrap; font-size: 23rpx; }
.copy { display: block; width: 100%; margin-top: 24rpx; }
.policy-card { margin-bottom: 24rpx; }
.policy-line { margin-bottom: 18rpx; font-size: 27rpx; line-height: 1.85; color: var(--text-sub); word-break: break-all; }
.policy-line:last-child { margin-bottom: 0; }
