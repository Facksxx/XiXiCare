{
  "name": "babycare",
  "private": true,
  "version": "1.1.31",
  "type": "module",
  "workspaces": [
    "XIXI-CARE-Site"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "apk": "node scripts/release-apk.mjs",
    "apk:build": "node scripts/package-apk.mjs",
    "apk:ci": "node scripts/package-apk.mjs --no-bump",
    "release:apk": "npm run apk",
    "site:dev": "npm run dev --workspace=XIXI-CARE-Site",
    "site:build": "npm run build --workspace=XIXI-CARE-Site",
    "site:test": "npm run test --workspace=XIXI-CARE-Site"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^7.1.8",
    "echarts": "^6.1.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
